module Rooibos
  # Declarative DSL for Fractal Architecture.
  module Router
  def self.included: (Class base) -> void

  # Duck type for Data-like models that support `with`.
  interface _DataModel
    def public_send: (Symbol, *Object) -> Object
    def with: (**Object) -> self
  end

  # Interface for fractal child modules (fragments).
  # Routed modules must have an UPDATE constant that handles child messages.
  # NOTE: We use Module here because RBS interfaces can't declare class methods.

  # Configuration for key handlers.
  class KeyHandlerConfig < Data
    attr_reader handler: (^() -> Command::execution?)?
    attr_reader action: Symbol?
    attr_reader route: Symbol?
    attr_reader guard: (^(_DataModel) -> bool)?

    def initialize: (?handler: (^() -> Command::execution?)?, ?action: Symbol?, ?route: Symbol?, ?guard: (^(_DataModel) -> bool)?) -> void
  end

  # Configuration for scroll handlers (no coordinates).
  class ScrollHandlerConfig < Data
    attr_reader handler: (^() -> Command::execution?)?
    attr_reader action: Symbol?

    def initialize: (?handler: (^() -> Command::execution?)?, ?action: Symbol?) -> void
  end

  # Configuration for click handlers (x, y coordinates).
  class ClickHandlerConfig < Data
    attr_reader handler: (^(Integer, Integer) -> Command::execution?)?
    attr_reader action: Symbol?

    def initialize: (?handler: (^(Integer, Integer) -> Command::execution?)?, ?action: Symbol?) -> void
  end

  # Configuration for intercept handlers (hash type used inline in Ruby).
  type intercept_handler_config = {
    predicate: ^(Object) -> bool,
    handler: ^(Object, _DataModel) -> (_DataModel | Command::execution? | [_DataModel, Command::execution?] | nil)
  }

  # Configuration for observe handlers (similar to intercept but continues processing).
  type observe_handler_config = {
    predicate: ^(Object) -> bool,
    handler: ^(Object, _DataModel) -> (_DataModel | Command::execution? | [_DataModel, Command::execution?] | nil)
  }

  # Configuration for forward handlers (type/envelope routing).
  # predicate uses untyped since we duck-type with respond_to?
  type forward_handler_config = {
    predicate: ^(untyped) -> bool,
    handler: (^(_DataModel, Object) -> (_DataModel | Command::execution? | [_DataModel, Command::execution?] | nil))?,
    action: Symbol?,
    broadcast: bool,
    broadcast_to: Array[Symbol]?,
    route_to: Symbol?
  }

  # Type alias for callable objects that can be validated for Ractor shareability.
  # Includes predicates (1-arg returning bool), handlers (2-arg returning update result),
  # and route accessors (reader: model -> child_model, writer: (model, child) -> model).
  type shareable_callable = (^(Object) -> bool) | (^(Object, _DataModel) -> (_DataModel | Command::execution? | [_DataModel, Command::execution?] | nil)) | (^(_DataModel) -> Object) | (^(_DataModel, Object) -> _DataModel) | nil

  # Guard wrapper for negated predicates.
  class NegatedGuard < Data
    attr_reader guard: ^(_DataModel) -> bool

    def initialize: (guard: ^(_DataModel) -> bool) -> void
    def call: (_DataModel model) -> bool
  end

  # Guard wrapper for combined predicates.
  class CombinedGuard < Data
    attr_reader guards: Array[^(_DataModel) -> bool | NegatedGuard | CombinedGuard]

    def initialize: (guards: Array[^(_DataModel) -> bool | NegatedGuard | CombinedGuard]) -> void
    def call: (_DataModel model) -> bool
  end

  # Class methods added when Router is included.
  module ClassMethods : Module
    # Configuration for a route.
    class RouteConfig < Data
      attr_reader fragment: Module
      attr_reader reader: (^(_DataModel) -> Object)?
      attr_reader writer: (^(_DataModel, Object) -> _DataModel)?

      def initialize: (fragment: Module, ?reader: (^(_DataModel) -> Object)?, ?writer: (^(_DataModel, Object) -> _DataModel)?) -> void
    end

    @routes: Hash[Symbol, RouteConfig]
    @actions: Hash[Symbol, ^() -> Command::execution?]
    @routed_actions: Hash[Symbol, Module]
    @key_handlers: Hash[Symbol, KeyHandlerConfig]
    @scroll_handlers: Hash[Symbol, ScrollHandlerConfig]
    @click_handler: ClickHandlerConfig?
    @intercept_handlers: Array[intercept_handler_config]
    @observe_handlers: Array[observe_handler_config]
    @forward_handlers: Array[forward_handler_config]
    @otherwise_handler: Symbol?

    def route: (?Symbol | String prefix, ?read: (^(_DataModel) -> Object)?, ?write: (^(_DataModel, Object) -> _DataModel)?, to: Module) -> void
    def routes: () -> Hash[Symbol, RouteConfig]

    # Action: multiple syntax forms supported
    def action: (
      ?(Symbol | String | ^() -> Command::execution?) name,
      ?(^() -> Command::execution? | Module) value,
      ?keymap: (Symbol | Array[Symbol])?,
      ?key: (Symbol | Array[Symbol])?,
      ?keys: (Symbol | Array[Symbol])?,
      ?mousemap: (Symbol | Array[Symbol])?,
      **(^() -> Command::execution? | Module) kwargs
    ) -> void
    def actions: () -> Hash[Symbol, ^() -> Command::execution?]
    def routed_actions: () -> Hash[Symbol, Module]

    private def register_action: (Symbol name, (^() -> Command::execution? | Module) value) -> void

    def keymap: () { (KeymapBuilder) [self: KeymapBuilder] -> void } -> void
    def key_handlers: () -> Hash[Symbol, KeyHandlerConfig]

    def mousemap: () { (MousemapBuilder) [self: MousemapBuilder] -> void } -> void
    def scroll_handlers: () -> Hash[Symbol, ScrollHandlerConfig]
    def click_handler: () -> ClickHandlerConfig?

    # Intercept handlers for early message termination
    def intercept: (
      ?(^(Object) -> bool) predicate,
      ?(^(Object, _DataModel) -> (_DataModel | Command::execution? | [_DataModel, Command::execution?] | nil)) handler,
      ?if: (^(Object) -> bool)?,
      ?when: (^(Object) -> bool)?,
      ?unless: (^(Object) -> bool)?,
      ?except: (^(Object) -> bool)?,
      ?then: (^(Object, _DataModel) -> (_DataModel | Command::execution? | [_DataModel, Command::execution?] | nil))?
    ) -> void
    def intercept_all: (^(Object, _DataModel) -> (_DataModel | Command::execution? | [_DataModel, Command::execution?] | nil) handler) -> void
    def intercept_handlers: () -> Array[intercept_handler_config]

    # Observe handlers (continue processing after match).
    def observe: (
      ?(^(Object) -> bool) predicate,
      ?(^(Object, _DataModel) -> (_DataModel | Command::execution? | [_DataModel, Command::execution?] | nil)) handler,
      ?if: (^(Object) -> bool)?,
      ?when: (^(Object) -> bool)?,
      ?unless: (^(Object) -> bool)?,
      ?except: (^(Object) -> bool)?,
      ?then: (^(Object, _DataModel) -> (_DataModel | Command::execution? | [_DataModel, Command::execution?] | nil))?
    ) -> void
    def observe_all: (^(Object, _DataModel) -> (_DataModel | Command::execution? | [_DataModel, Command::execution?] | nil) handler) -> void
    def observe_handlers: () -> Array[observe_handler_config]

    private def validate_shareable!: (shareable_callable callable, String label) -> void

    # Forward handlers for message type/envelope routing.
    def forward: () { (ForwardBuilder) [self: ForwardBuilder] -> void } -> void
    def forward_handlers: () -> Array[forward_handler_config]

    # Otherwise fallback (routes unhandled messages to a fragment).
    def otherwise: (route_to: Symbol | String) -> void
    private def otherwise_handler: () -> Symbol?

    # Returns UPDATE callable that handles routing.
    # Uses is_a? checks for Event::Key and Event::Mouse type narrowing.
    # Model must be Data-like with `with` and field accessors.
    def from_router: () -> RouterUpdate
  end

  # UPDATE callable returned by from_router with proper typing.
  # Implements #call to satisfy Proc-like interfaces.
  class RouterUpdate
    @routes: Hash[Symbol, ClassMethods::RouteConfig]
    @actions: Hash[Symbol, ^() -> Command::execution?]
    @routed_actions: Hash[Symbol, Module]
    @key_handlers: Hash[Symbol, KeyHandlerConfig]
    @scroll_handlers: Hash[Symbol, ScrollHandlerConfig]
    @click_handler: ClickHandlerConfig?
    @intercept_handlers: Array[intercept_handler_config]
    @observe_handlers: Array[observe_handler_config]
    @forward_handlers: Array[forward_handler_config]
    @otherwise_handler: Symbol?

    def initialize: (
      routes: Hash[Symbol, ClassMethods::RouteConfig],
      actions: Hash[Symbol, ^() -> Command::execution?],
      routed_actions: Hash[Symbol, Module],
      key_handlers: Hash[Symbol, KeyHandlerConfig],
      scroll_handlers: Hash[Symbol, ScrollHandlerConfig],
      click_handler: ClickHandlerConfig?,
      intercept_handlers: Array[intercept_handler_config],
      observe_handlers: Array[observe_handler_config],
      forward_handlers: Array[forward_handler_config],
      otherwise_handler: Symbol?
    ) -> void

    # Process message and return [model, command] tuple.
    def call: (
      (RatatuiRuby::Event::Key | RatatuiRuby::Event::Mouse | Array[Object]) message,
      _DataModel model
    ) -> [_DataModel, Command::execution?]

    private

    def normalize_handler_result: (
      (_DataModel | Command::execution? | [_DataModel, Command::execution?] | nil) result,
      _DataModel previous_model
    ) -> [_DataModel, Command::execution?]

    def extract_bubbles_from_command: (
      Command::execution? cmd,
      _DataModel model,
      Array[Command::execution?] accumulated_commands
    ) -> _DataModel

    def process_bubble: (
      Object bubbled_message,
      _DataModel model,
      Array[Command::execution?] accumulated_commands
    ) -> _DataModel

    def merge_commands: (Array[Command::execution?] commands) -> Command::execution?

    def find_route_config: (Symbol | String | Module identifier) -> ([Symbol, ClassMethods::RouteConfig] | [nil, nil])
  end

  # Builder for keymap DSL.
  class KeymapBuilder
    @handlers: Hash[String, KeyHandlerConfig]
    @guard_stack: Array[^(_DataModel) -> bool]

    attr_reader handlers: Hash[String, KeyHandlerConfig]

    def initialize: () -> void

    # Variadic key binding: accepts multiple keys, optional action kwarg, hash bindings
    def key: (
      *(String | Symbol | ^() -> Command::execution? | Hash[Symbol, (^() -> Command::execution?) | Symbol]) args,
      ?action: Symbol?,
      ?route: Symbol?,
      ?when: (^(_DataModel) -> bool)?,
      ?if: (^(_DataModel) -> bool)?,
      ?only: (^(_DataModel) -> bool)?,
      ?guard: (^(_DataModel) -> bool)?,
      ?unless: (^(_DataModel) -> bool)?,
      ?except: (^(_DataModel) -> bool)?,
      ?skip: (^(_DataModel) -> bool)?,
      **(^() -> Command::execution? | Symbol) bindings
    ) -> void

    # Alias for key (reads better with multiple keys)
    alias keys key

    def only: (
      ?when: (^(_DataModel) -> bool)?,
      ?if: (^(_DataModel) -> bool)?,
      ?only: (^(_DataModel) -> bool)?,
      ?guard: (^(_DataModel) -> bool)?
    ) { () -> void } -> void

    def skip: (
      ?when: (^(_DataModel) -> bool)?,
      ?if: (^(_DataModel) -> bool)?,
      ?skip: (^(_DataModel) -> bool)?,
      ?guard: (^(_DataModel) -> bool)?
    ) { () -> void } -> void

    private

    def with_guard: ((^(_DataModel) -> bool)?) { () -> void } -> void
    def register_key_handler: ((Symbol | String) key_name, (^() -> Command::execution? | Symbol)? handler, (Symbol | String | ^() -> Command::execution?)? action_name, Symbol? route, (^(_DataModel) -> bool)? guard) -> void
  end

  # Builder for mousemap DSL.
  class MousemapBuilder
    @scroll_handlers: Hash[Symbol, ScrollHandlerConfig]
    @click_handler: ClickHandlerConfig?

    attr_reader scroll_handlers: Hash[Symbol, ScrollHandlerConfig]
    attr_reader click_handler: ClickHandlerConfig?

    def initialize: () -> void

    def click: ((^(Integer, Integer) -> Command::execution?) | Symbol handler_or_action) -> void
    def scroll: (:up | :down direction, (^() -> Command::execution?) | Symbol handler_or_action) -> void
  end

  # Builder for forward DSL.
  class ForwardBuilder
    @handlers: Array[forward_handler_config]

    attr_reader handlers: Array[forward_handler_config]

    def initialize: () -> void

    # Routes messages by type predicate.
    def with_type: (
      (Symbol | String) type_name,
      ?action: Symbol?,
      ?broadcast: bool,
      ?broadcast_to: Array[Symbol]?
    ) ?{ (_DataModel, Object) -> (_DataModel | Command::execution? | [_DataModel, Command::execution?] | nil) } -> void

    # Routes messages by envelope attribute.
    def with_envelope: (
      (Symbol | String) envelope_name,
      ?route_to: Symbol?
    ) ?{ (_DataModel, Object) -> (_DataModel | Command::execution? | [_DataModel, Command::execution?] | nil) } -> void
  end
end
end
